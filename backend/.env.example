# Local development only. Copy to backend/.env.
PORT=3001
JWT_KEY=local-development-only-change-for-production

# Matches compose.yaml; PostgreSQL listens on localhost:5432.
DEV_DB_USERNAME=conduit
DEV_DB_PASSWORD=conduit_dev
DEV_DB_NAME=conduit_dev
DEV_DB_HOSTNAME=127.0.0.1
DEV_DB_DIALECT=postgres

# Integration settings are supplied by vitest.integration.config.js.
# Production settings are supplied by compose.production.yaml.
